// Распиновка для Tang Nano 20K

// Тактовый вход 27 МГц
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Кнопка S1: активна в "1", поэтому подтяжка вниз
IO_LOC "rst" 88;
IO_PORT "rst" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// UART к встроенному USB-UART (BL616)
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP; //линия простоя держится в 1
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33;

// Шесть светодиодов на плате, горят от "0"
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// Внешние светодиоды, активны в "1": pin -> резистор -> светодиод -> GND
IO_LOC "ext_led[0]" 76;
IO_PORT "ext_led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[1]" 80;
IO_PORT "ext_led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[2]" 42;
IO_PORT "ext_led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[3]" 41;
IO_PORT "ext_led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[4]" 56;
IO_PORT "ext_led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[5]" 54;
IO_PORT "ext_led[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[6]" 51;
IO_PORT "ext_led[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ext_led[7]" 48;
IO_PORT "ext_led[7]" IO_TYPE=LVCMOS33 DRIVE=8;
